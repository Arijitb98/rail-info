{
  "name": "rail-info-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run generate && tsc",
    "generate": "prisma generate",
    "start": "node dist/index.js",
    "scrape:schedules": "tsx src/jobs/scrape-schedules.ts",
    "scrape:stations": "tsx src/jobs/scrape-stations.ts",
    "postinstall": "npm run generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "node-cron": "^3.0.3",
    "p-queue": "^8.1.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "prisma": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "imports": {
    "#prisma/*": "../src/generated/prisma/*"
  }
